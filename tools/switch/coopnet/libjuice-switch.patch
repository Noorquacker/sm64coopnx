+// libnx forwards getnameinfo() to the system resolver, which does a reverse DNS lookup even
+// with NI_NUMERICHOST. That can take seconds per address, and libjuice formats addresses while
+// holding its connection lock, which then stalls juice_send() and candidate handling.
+static inline int switch_numeric_getnameinfo(const struct sockaddr *sa, socklen_t salen,
+                                             char *host, socklen_t hostlen, char *serv,
+                                             socklen_t servlen, int flags) {
+	(void)flags;
+	const void *src;
+	unsigned short port;
+	if (sa->sa_family == AF_INET && salen >= (socklen_t)sizeof(struct sockaddr_in)) {
+		src = &((const struct sockaddr_in *)sa)->sin_addr;
+		port = ntohs(((const struct sockaddr_in *)sa)->sin_port);
+	} else if (sa->sa_family == AF_INET6 && salen >= (socklen_t)sizeof(struct sockaddr_in6)) {
+		src = &((const struct sockaddr_in6 *)sa)->sin6_addr;
+		port = ntohs(((const struct sockaddr_in6 *)sa)->sin6_port);
+	} else {
+		return EAI_FAMILY;
+	}
+	if (host && hostlen > 0 && !inet_ntop(sa->sa_family, src, host, hostlen))
+		return EAI_OVERFLOW;
+	if (serv && servlen > 0 && snprintf(serv, servlen, "%hu", port) >= (int)servlen)
+		return EAI_OVERFLOW;
+	return 0;
+}
